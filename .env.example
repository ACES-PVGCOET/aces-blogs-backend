# Copy this file to .env (never commit .env) and fill in your own values.

# PostgreSQL (Prisma reads this one connection string)
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/blog_app?schema=public

# Auth: use a long random value, never reuse it outside your machine
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Cloudinary (blog-uploads-api). Leave empty until you need uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App. 4000 so it doesn't clash with the Next.js frontend on 3000.
PORT=4000
# Comma-separated list of frontend origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Tests (npm run test:e2e): use a SEPARATE database whose name contains "test".
# DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/blog_app_test?schema=public
