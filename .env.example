# Copy this file to .env (never commit .env) and fill in your own values.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_me
DB_NAME=blog_app
# true = TypeORM creates/alters tables automatically. Local development ONLY; leave unset anywhere else.
DB_SYNC=true

# Auth: use a long random value, never reuse it outside your machine
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Cloudinary (blog-uploads-api). Leave empty until you need uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App. 4000 so it doesn't clash with the Next.js frontend on 3000.
PORT=4000
# Comma-separated list of frontend origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Tests (npm run test:e2e): use a SEPARATE database whose name contains "test".
# DB_NAME=blog_app_test
